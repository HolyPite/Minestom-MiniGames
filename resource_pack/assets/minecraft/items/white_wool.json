{
  "model": {
    "type": "select",
    "property": "custom_model_data",
    "index": 0,
    "cases": [
      { "when": ["taupe"], "model": { "type": "model", "model": "item/taupe_wool" } },
      { "when": ["greta"], "model": { "type": "model", "model": "item/greta_wool" } },
      { "when": ["explosive"], "model": { "type": "model", "model": "item/explosive_wool" } },
      { "when": ["black_hole"], "model": { "type": "model", "model": "item/black_hole_wool" } },
      { "when": ["geyser"], "model": { "type": "model", "model": "item/geyser_wool" } },
      { "when": ["random", "mystery"], "model": { "type": "model", "model": "item/random_wool" } },
      { "when": ["shield"], "model": { "type": "model", "model": "item/shield_wool" } },
      { "when": ["invisible"], "model": { "type": "model", "model": "item/invisible_wool" } },
      { "when": ["honey"], "model": { "type": "model", "model": "item/honey_wool" } },
      { "when": ["seeker"], "model": { "type": "model", "model": "item/seeker_wool" } },
      { "when": ["heal"], "model": { "type": "model", "model": "item/heal_wool" } },
      { "when": ["jaw"], "model": { "type": "model", "model": "item/jaw_wool" } },
      { "when": ["boarding"], "model": { "type": "model", "model": "item/boarding_wool" } },
      { "when": ["incendiary"], "model": { "type": "model", "model": "item/incendiary_wool" } },
      { "when": ["shuffle"], "model": { "type": "model", "model": "item/shuffle_wool" } },
      { "when": ["icy"], "model": { "type": "model", "model": "item/icy_wool" } },
      { "when": ["spider"], "model": { "type": "model", "model": "item/spider_wool" } },
      { "when": ["storm"], "model": { "type": "model", "model": "item/storm_wool" } },
      { "when": ["anvil"], "model": { "type": "model", "model": "item/anvil_wool" } },
      { "when": ["eater", "glutton"], "model": { "type": "model", "model": "item/eater_wool" } },
      { "when": ["sticky"], "model": { "type": "model", "model": "item/sticky_wool" } },
      { "when": ["fragmentation"], "model": { "type": "model", "model": "item/fragmentation_wool" } },
      { "when": ["parasite"], "model": { "type": "model", "model": "item/parasite_wool" } },
      { "when": ["earthquake"], "model": { "type": "model", "model": "item/earthquake_wool" } },
      { "when": ["trapped"], "model": { "type": "model", "model": "item/trapped_wool" } },
      { "when": ["positive_potion"], "model": { "type": "model", "model": "item/positive_potion_wool" } },
      { "when": ["negative_potion"], "model": { "type": "model", "model": "item/negative_potion_wool" } },
      { "when": ["chain_reaction"], "model": { "type": "model", "model": "item/chain_reaction_wool" } },
      { "when": ["thorny"], "model": { "type": "model", "model": "item/thorny_wool" } },
      { "when": ["clone"], "model": { "type": "model", "model": "item/clone_wool" } },
      { "when": ["party"], "model": { "type": "model", "model": "item/party_wool" } },
      { "when": ["hedgehog"], "model": { "type": "model", "model": "item/hedgehog_wool" } },
      { "when": ["nightmare"], "model": { "type": "model", "model": "item/nightmare_wool" } },
      { "when": ["radioactive"], "model": { "type": "model", "model": "item/radioactive_wool" } },
      { "when": ["burrower"], "model": { "type": "model", "model": "item/burrower_wool" } },
      { "when": ["glowing"], "model": { "type": "model", "model": "item/glowing_wool" } }
